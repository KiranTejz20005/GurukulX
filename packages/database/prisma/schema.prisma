generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspaces        WorkspaceMember[]
  courses           Course[]          @relation("CourseInstructor")
  enrollments       Enrollment[]
  submissions       Submission[]
  quizAttempts      QuizAttempt[]
  forumPosts        ForumPost[]
  completionRecords CourseCompletionRecord[]
  certificates      Certificate[]
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  customDomain String? @unique
  branding    String?    // Json string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members               WorkspaceMember[]
  courses               Course[]
  forums                Forum[]
  programs              Program[]
  tags                  Tag[]
  tagGroups             TagGroup[]
  media                 Media[]
  apiKeys               ApiKey[]
  analyticsEvents       AnalyticsPageEvent[]
  analyticsOrgDaily     AnalyticsOrgDaily[]
  analyticsCountryDaily AnalyticsCountryDaily[]
  certificates          Certificate[]
  invites               WorkspaceInvite[]
  widgets               Widget[]
  notifications         Notification[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("STUDENT") // Enum string
  createdAt   DateTime  @default(now())
  
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
}

model Course {
  id              String    @id @default(cuid())
  workspaceId     String
  instructorId    String
  title           String
  description     String?
  type            String    @default("SELF_PACED") // "SELF_PACED", "LIVE_CLASS", "COMPLIANCE"
  validityMonths  Int?      @default(12)
  gracePeriodDays Int?      @default(14)
  published       Boolean   @default(false)
  thumbnail       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  workspace            Workspace                @relation(fields: [workspaceId], references: [id])
  instructor           User                     @relation("CourseInstructor", fields: [instructorId], references: [id])
  modules              Module[]
  enrollments          Enrollment[]
  tags                 CourseTag[]
  programs             ProgramCourse[]
  analyticsCourseDaily AnalyticsCourseDaily[]
  completionRecords    CourseCompletionRecord[]
  certificates         Certificate[]
  widgets              WidgetCourse[]
}

model Enrollment {
  id          String    @id @default(cuid())
  courseId    String
  userId      String
  enrolledAt  DateTime  @default(now())
  progress    Int       @default(0)
  completedAt DateTime?

  course      Course    @relation(fields: [courseId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

model Module {
  id          String    @id @default(cuid())
  courseId    String
  title       String
  order       Int
  
  course      Course    @relation(fields: [courseId], references: [id])
  lessons     Lesson[]
}

model Lesson {
  id          String     @id @default(cuid())
  moduleId    String
  title       String
  type        String     // Enum string
  content     String?    // Rich text or JSON for editor
  videoUrl    String?    // Cloudflare R2 URL
  order       Int
  isPublished Boolean    @default(false)

  module      Module     @relation(fields: [moduleId], references: [id])
  progress    Progress[]
  quiz        Quiz?
  assignment  Assignment?
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(false)
  completedAt DateTime?

  lesson      Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model Quiz {
  id          String     @id @default(cuid())
  lessonId    String     @unique
  questions   String     // Json string
  passingScore Int       @default(70)

  lesson      Lesson     @relation(fields: [lessonId], references: [id])
  attempts    QuizAttempt[]
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  passed      Boolean

  user        User     @relation(fields: [userId], references: [id])
  quiz        Quiz     @relation(fields: [quizId], references: [id])
}

model Assignment {
  id          String     @id @default(cuid())
  lessonId    String     @unique
  prompt      String
  dueDate     DateTime?

  lesson      Lesson     @relation(fields: [lessonId], references: [id])
  submissions Submission[]
}

model Submission {
  id           String     @id @default(cuid())
  userId       String
  assignmentId String
  content      String
  grade        Int?
  submittedAt  DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id])
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
}

model Forum {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  description String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  posts       ForumPost[]
}

model ForumPost {
  id          String   @id @default(cuid())
  forumId     String
  userId      String
  content     String
  createdAt   DateTime @default(now())

  forum       Forum    @relation(fields: [forumId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model Program {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  description String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  courses     ProgramCourse[]
}

model ProgramCourse {
  id          String   @id @default(cuid())
  programId   String
  courseId    String
  order       Int

  program     Program  @relation(fields: [programId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])

  @@unique([programId, courseId])
}

model TagGroup {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String?
  selectionMode String @default("SINGLE") // SINGLE, MULTI
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tags        Tag[]
}

model Tag {
  id          String    @id @default(cuid())
  workspaceId String
  groupId     String?
  name        String
  color       String?
  description String?
  createdAt   DateTime  @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  group       TagGroup? @relation(fields: [groupId], references: [id])
  courses     CourseTag[]
}

model CourseTag {
  courseId    String
  tagId       String

  course      Course   @relation(fields: [courseId], references: [id])
  tag         Tag      @relation(fields: [tagId], references: [id])

  @@id([courseId, tagId])
}

model Media {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  filename    String
  mimeType    String
  size        Int
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model ApiKey {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  key         String   @unique
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model AnalyticsPageEvent {
  id          String   @id @default(cuid())
  workspaceId String
  courseId    String?
  userId      String?
  eventType   String   // "landing_view", "course_page_view", "enrollment_completed", "course_completed"
  country     String?
  userAgent   String?
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, eventType, createdAt])
}

model AnalyticsOrgDaily {
  id              String   @id @default(cuid())
  workspaceId     String
  date            String   // YYYY-MM-DD
  landingViews    Int      @default(0)
  coursePageViews Int      @default(0)
  uniqueVisitors  Int      @default(0)
  enrollments     Int      @default(0)
  completions     Int      @default(0)
  createdAt       DateTime @default(now())

  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date])
}

model AnalyticsCourseDaily {
  id          String   @id @default(cuid())
  workspaceId String
  courseId    String
  date        String   // YYYY-MM-DD
  views       Int      @default(0)
  enrollments Int      @default(0)
  completions Int      @default(0)
  createdAt   DateTime @default(now())

  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, date])
}

model AnalyticsCountryDaily {
  id          String   @id @default(cuid())
  workspaceId String
  date        String   // YYYY-MM-DD
  country     String
  views       Int      @default(0)
  enrollments Int      @default(0)
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, date, country])
}

model CourseCompletionRecord {
  id           String    @id @default(cuid())
  courseId     String
  userId       String
  status       String    // "compliant", "non_compliant", "expiring_soon", "in_grace_period", "in_progress", "not_started", "waived"
  completedAt  DateTime?
  validUntil   DateTime?
  cycleNumber  Int       @default(1)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([courseId, userId, cycleNumber])
}

model Certificate {
  id              String   @id @default(cuid())
  workspaceId     String
  userId          String
  courseId        String
  certificateNumber String @unique
  issuedAt        DateTime @default(now())
  expiresAt       DateTime?
  status          String   @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED

  user            User      @relation(fields: [userId], references: [id])
  course          Course    @relation(fields: [courseId], references: [id])
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, courseId, userId])
}

model Widget {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  theme       String   @default("dark") // dark, light, system
  layout      String   @default("grid") // grid, list, carousel
  primaryColor String  @default("#3b82f6")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  courses     WidgetCourse[]
  versions    WidgetVersion[]
}

model WidgetCourse {
  widgetId    String
  courseId    String
  order       Int      @default(0)

  widget      Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([widgetId, courseId])
}

model WidgetVersion {
  id          String   @id @default(cuid())
  widgetId    String
  version     Int
  config      String   // JSON configuration snapshot
  createdAt   DateTime @default(now())

  widget      Widget   @relation(fields: [widgetId], references: [id], onDelete: Cascade)
}

model WorkspaceInvite {
  id          String   @id @default(cuid())
  workspaceId String
  email       String
  role        String   @default("STUDENT")
  token       String   @unique
  status      String   @default("PENDING") // PENDING, ACCEPTED, REVOKED, EXPIRED
  expiresAt   DateTime
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Notification {
  id          String   @id @default(cuid())
  workspaceId String
  type        String   // ENROLLMENT | COURSE_PUBLISHED | COURSE_CREATED | QUIZ_ATTEMPT | SUBMISSION | FORUM_POST | API_KEY | MEMBER_JOINED | AI_COMPLETE | SYSTEM
  title       String
  message     String
  read        Boolean  @default(false)
  link        String?
  actorName   String?
  actorEmail  String?
  metadata    String?  // JSON string for extra context
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}
