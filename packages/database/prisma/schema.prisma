generator client {
  provider = "prisma-client-js"
  output   = "../../../node_modules/@prisma/client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  workspaces    WorkspaceMember[]
  courses       Course[]          @relation("CourseInstructor")
  enrollments   Enrollment[]
  submissions   Submission[]
  quizAttempts  QuizAttempt[]
  forumPosts    ForumPost[]
}

model Workspace {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  customDomain String? @unique
  branding    String?    // Json string
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     WorkspaceMember[]
  courses     Course[]
  forums      Forum[]
  programs    Program[]
  tags        Tag[]
  media       Media[]
  apiKeys     ApiKey[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        String    @default("STUDENT") // Enum string
  createdAt   DateTime  @default(now())
  
  user        User      @relation(fields: [userId], references: [id])
  workspace   Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([userId, workspaceId])
}

model Course {
  id          String    @id @default(cuid())
  workspaceId String
  instructorId String
  title       String
  description String?
  published   Boolean   @default(false)
  thumbnail   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  instructor  User      @relation("CourseInstructor", fields: [instructorId], references: [id])
  modules     Module[]
  enrollments Enrollment[]
  tags        CourseTag[]
  programs    ProgramCourse[]
}

model Enrollment {
  id          String    @id @default(cuid())
  courseId    String
  userId      String
  enrolledAt  DateTime  @default(now())

  course      Course    @relation(fields: [courseId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@unique([userId, courseId])
}

model Module {
  id          String    @id @default(cuid())
  courseId    String
  title       String
  order       Int
  
  course      Course    @relation(fields: [courseId], references: [id])
  lessons     Lesson[]
}

model Lesson {
  id          String     @id @default(cuid())
  moduleId    String
  title       String
  type        String     // Enum string
  content     String?    // Rich text or JSON for editor
  videoUrl    String?    // Cloudflare R2 URL
  order       Int
  isPublished Boolean    @default(false)

  module      Module     @relation(fields: [moduleId], references: [id])
  progress    Progress[]
  quiz        Quiz?
  assignment  Assignment?
}

model Progress {
  id          String   @id @default(cuid())
  userId      String
  lessonId    String
  completed   Boolean  @default(false)
  completedAt DateTime?

  lesson      Lesson   @relation(fields: [lessonId], references: [id])

  @@unique([userId, lessonId])
}

model Quiz {
  id          String     @id @default(cuid())
  lessonId    String     @unique
  questions   String     // Json string
  passingScore Int       @default(70)

  lesson      Lesson     @relation(fields: [lessonId], references: [id])
  attempts    QuizAttempt[]
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  passed      Boolean

  user        User     @relation(fields: [userId], references: [id])
  quiz        Quiz     @relation(fields: [quizId], references: [id])
}

model Assignment {
  id          String     @id @default(cuid())
  lessonId    String     @unique
  prompt      String
  dueDate     DateTime?

  lesson      Lesson     @relation(fields: [lessonId], references: [id])
  submissions Submission[]
}

model Submission {
  id           String     @id @default(cuid())
  userId       String
  assignmentId String
  content      String
  grade        Int?
  submittedAt  DateTime   @default(now())

  user         User       @relation(fields: [userId], references: [id])
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
}

model Forum {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  description String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  posts       ForumPost[]
}

model ForumPost {
  id          String   @id @default(cuid())
  forumId     String
  userId      String
  content     String
  createdAt   DateTime @default(now())

  forum       Forum    @relation(fields: [forumId], references: [id])
  user        User     @relation(fields: [userId], references: [id])
}

model Program {
  id          String   @id @default(cuid())
  workspaceId String
  title       String
  description String?
  published   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  courses     ProgramCourse[]
}

model ProgramCourse {
  id          String   @id @default(cuid())
  programId   String
  courseId    String
  order       Int

  program     Program  @relation(fields: [programId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])

  @@unique([programId, courseId])
}

model Tag {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String?

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
  courses     CourseTag[]
}

model CourseTag {
  courseId    String
  tagId       String

  course      Course   @relation(fields: [courseId], references: [id])
  tag         Tag      @relation(fields: [tagId], references: [id])

  @@id([courseId, tagId])
}

model Media {
  id          String   @id @default(cuid())
  workspaceId String
  url         String
  filename    String
  mimeType    String
  size        Int
  createdAt   DateTime @default(now())

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}

model ApiKey {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  key         String   @unique
  createdAt   DateTime @default(now())
  lastUsedAt  DateTime?

  workspace   Workspace @relation(fields: [workspaceId], references: [id])
}
