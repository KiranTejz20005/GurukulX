# =========================================================================
# GurukulX Monorepo Environment Variables Template
# Copy this file to .env and configure the values.
# =========================================================================

# --- APP CONFIGURATION ---
NODE_ENV=development
PORT=3005

# --- WEB APP (Next.js) ---
NEXT_PUBLIC_API_URL=http://localhost:3005

# --- DATABASE CONFIGURATION ---
# Default SQLite database URL (can be customized if needed)
DATABASE_URL="file:d:/My projects/GurukulX/GurukulX/packages/database/prisma/dev.db"

# --- AUTHENTICATION (Next-Auth or JWT) ---
# Generate a secret via: openssl rand -base64 32
NEXTAUTH_SECRET=your_nextauth_secret_here
NEXTAUTH_URL=http://localhost:3000
JWT_SECRET=your_jwt_secret_here

# --- CLOUD STORAGE (Cloudflare R2 / AWS S3) ---
# Used for storing uploaded lesson videos and course media assets
R2_ACCOUNT_ID=your_cloudflare_account_id_here
R2_ACCESS_KEY_ID=your_access_key_id_here
R2_SECRET_ACCESS_KEY=your_secret_access_key_here
R2_BUCKET_NAME=your_bucket_name_here
NEXT_PUBLIC_R2_PUBLIC_URL=https://your-public-bucket-url.com

# --- SMTP / EMAIL CONFIGURATION ---
# For sending verification emails, student enrollments, and notifications
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM_EMAIL=noreply@gurukulx.com
SMTP_FROM_NAME="GurukulX Support"
